# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design/reference artifacts (not used by the app)
/src/design_frames/
/reference/
# unused 130MB source image (exceeds GitHub 100MB limit; not imported anywhere)
/src/assets/layer-1.png
# 20MB full-res logo source; the app uses the optimized /public/media/logo.png
/public/media/logo-new.png
